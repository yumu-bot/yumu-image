PORT=8388
EXPORT_FILE="/Users/siyuyuko/Documents/ExportFileV3"
BUFFER_PATH="/Users/siyuyuko/Documents/yumu-bot-run/imgbuffer"
OSU_BUFFER_PATH="/Users/siyuyuko/Documents/yumu-bot-run/osufile"
USE_PROXY=true
OSUFILE_NO_PROXY=true
PROXY_SCHEME=http
PROXY_HOST=127.0.0.1
PROXY_PORT=7890
IMAGE_FORMAT=png
ADVANCED_FORMAT=png
BUN_CHROME_PATH="/usr/bin/chromium"

# —— Bun.WebView / Chromium ——
# 每个 Bun 进程独享一个 Chromium profile。默认 ~/.cache/yumu-image/chrome-profiles，
# 生产环境建议指到服务数据盘，避免 /tmp 配额和多个实例互相踩踏。
# CHROME_PROFILE_ROOT=/var/lib/yumu-image/chrome-profiles
#
# main.js 的 MAX_CONCURRENT 默认是 1，因此每个进程通常只需要 1 个页面。
# 如果改为单进程高并发，可同时调大 MAX_CONCURRENT 与 SVG_RENDER_POOL_SIZE。
# MAX_CONCURRENT=1
# SVG_RENDER_POOL_SIZE=1
# 空闲页面保留数量/关闭时间（毫秒）
# SVG_IDLE_KEEP=1
# SVG_IDLE_TIMEOUT=60000
# 单个 SVG 页面的加载/清理超时（毫秒）
# SVG_LOAD_TIMEOUT=15000
# SVG_CLEANUP_TIMEOUT=3000
# 单次渲染任务总超时（毫秒），应小于 main.js 的 30s 熔断
# SVG_RENDER_TIMEOUT=20000
# 异常情况下 SVG 内存缓存的兜底上限（正常截图后立即释放）
# SVG_CACHE_SIZE=32
# 额外的 Chromium 启动参数（空格分隔，会追加到内置的 sandbox 参数后）
# 例：减少磁盘缓存写入（上线前请先验证渲染结果）
# SVG_CHROME_ARGS="--disk-cache-size=1048576 --media-cache-size=1048576"
# 容器内 /dev/shm 太小时可加 --disable-dev-shm-usage（注意它会改用 /tmp）
#
# 退出时等待在途任务/关闭渲染器的总超时（毫秒）
# SHUTDOWN_DRAIN_TIMEOUT=15000
# SHUTDOWN_CLOSE_TIMEOUT=15000
